# Gabarit de `.env`. Copier en `.env` et renseigner le jeton.
# `.env` est gitignoré : il porte un secret en clair et ne doit jamais être
# committé. Aucun module du pipeline ne lit ce fichier — les étages réseau
# lisent AWS_BEARER_TOKEN_BEDROCK dans l'environnement.

# Jeton Bedrock (préfixe ABSK…). Ouvre le plan de données bedrock-runtime et le
# plan de contrôle bedrock, mais PAS S3 ni STS : il n'y a pas de credentials
# SigV4 ici, donc le batch — qui lit et écrit ses lots dans S3 — reste hors de
# portée. C'est pourquoi l'étage 09 tourne en on-demand. Détail :
# `.claude/skills/pf-bedrock-batch/SKILL.md` et `docs/enrichissement.md`.
BEDROCK_TOKEN=

# Le préfixe de profil d'inférence (`eu.` ou `global.`) est OBLIGATOIRE : un id
# de modèle nu ne supporte que INFERENCE_PROFILE et se fait refuser.
REGION = "eu-central-1"
MODEL = "global.anthropic.claude-haiku-4-5-20251001-v1:0"
