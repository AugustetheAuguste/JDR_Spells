__pycache__/
*.pyc
.pytest_cache/
.venv/

# Métadonnées laissées par `pip install -e .`, la forme installable documentée
# dans le README. Régénérées à chaque installation, propres à une machine.
*.egg-info/
build/
dist/

# Secrets. `.env` porte un jeton Bedrock en clair : jamais committé, jamais lu
# par un module du pipeline (le jeton passe par l'environnement).
.env
.env.*
!.env.example

# Sorties de fumée de l'étage 08 sous la fixture : régénérables, et régénérées
# dans tmp_path par les tests. Committer un lot figerait une copie périmée à côté
# du module qui la produit. Le `build_artifacts/` de la racine, lui, EST committé :
# c'est la trace d'appels payants, donc une pièce d'audit, pas un artefact jetable.
tests/fixtures/mini_corpus/build_artifacts/

# Prompts assemblés : 22 Mo dont 88 % le même bloc système répété 2 070 fois,
# régénérables hors ligne en quelques secondes par
# `python -m pf_spells.prepare_prompts`. Contrairement à
# `build_artifacts/taxo_passe0/`, aucun appel payant n'y est engagé : il n'y a
# donc pas de trace d'audit à conserver, seulement du poids.
build_artifacts/prompts/
